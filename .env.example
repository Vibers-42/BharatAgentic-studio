# Copy this file to .env and fill in your own values. Never commit .env.

# --- Database (the db container is never published outside Docker) ---
POSTGRES_USER=bharat
# Pick your own strong password; the db container refuses to start without one.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bharatagent

# --- Gemini API (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Second free API: Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Local model through Ollama (pulled into the ollama container) ---
OLLAMA_CHAT_MODEL=qwen2.5:3b
# One multilingual embedding model for the whole index (works for Telugu and Hindi).
OLLAMA_EMBED_MODEL=bge-m3

# --- GitHub (optional, raises the rate limit when ingesting public repos) ---
GITHUB_TOKEN=

# --- Cost display ---
USD_TO_INR=84
