# Copy this file to .env and fill in your own values. Never commit .env.

# --- Database (the db container is never published outside Docker) ---
POSTGRES_USER=bharat
# Pick your own strong password; the db container refuses to start without one.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bharatagent

# --- Gemini API (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Second free API: Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Local model through Ollama (pulled into the ollama container) ---
# Main local model (needs ~10 GB; see docker-compose.gpu.yml to use an NVIDIA GPU) and a small backup.
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_BACKUP_MODEL=qwen2.5:3b
# One multilingual embedding model for the whole index (works for Telugu and Hindi).
OLLAMA_EMBED_MODEL=bge-m3
# Most tokens a local model may write per reply (stops a small model stuck in a repetition loop)
OLLAMA_NUM_PREDICT=1536

# --- Retrieval (optional; defaults shown) ---
# Chunks sent to the model, and the lowest cosine similarity that counts as relevant (tuned for bge-m3).
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.50
MAX_UPLOAD_MB=20

# --- Privacy: true = local models only for everyone; no question or document is sent to a cloud LLM ---
LOCAL_ONLY=false

# --- Docs links (leave false: true lets links reach private/internal addresses, for local tests only) ---
ALLOW_PRIVATE_URLS=false

# --- GitHub (optional: private repos, and a higher limit than 60 downloads an hour) ---
GITHUB_TOKEN=

# --- Cost display ---
# Prices in api/app/models/prices.json are in USD; set today's rate before the demo.
USD_TO_INR=84

# Phase 8 accounts and sessions
# Hours a sign-in lasts.
SESSION_HOURS=24
# true when the app is served over HTTPS (production): the session cookie is then only sent over HTTPS.
# Keep false for http://localhost, where browsers would refuse a Secure cookie.
COOKIE_SECURE=false
# Days an invitation link stays valid.
INVITATION_DAYS=7
# Earlier messages a follow-up question may see (bounded to limit tokens).
CHAT_HISTORY_MESSAGES=4
